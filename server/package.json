{
	"name": "ifndev",
	"module": "/src/server.ts",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "bun --bun --watch --env-file=../.env src/server.ts",
		"prod": "bun --bun src/server.ts",
		"db:pull": "bunx --env-file=../.env prisma db pull",
		"db:gen": "bunx --env-file=../.env prisma generate",
		"db:migrate": "bunx --env-file=../.env prisma migrate dev",
		"db:studio": "bunx --env-file=../.env prisma studio",
		"postinstall": "bun run db:gen"
	},
	"dependencies": {
		"@abcx3/prisma-bun-adapter": "^1.3.1",
		"@prisma/adapter-better-sqlite3": "^7.3.0",
		"@prisma/client": "^7.3.0",
		"@types/better-sqlite3": "^7.6.13",
		"bcrypt": "^6.0.0",
		"cookie-parser": "^1.4.7",
		"cors": "^2.8.6",
		"dotenv": "^17.2.4",
		"express": "^5.2.1",
		"express-rate-limit": "^8.2.1",
		"jsonwebtoken": "^9.0.3",
		"multer": "^2.0.2",
		"socket.io": "^4.8.3",
		"sqlite3": "^5.1.7",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@types/bcrypt": "^6.0.0",
		"@types/cookie-parser": "^1.4.10",
		"@types/cors": "^2.8.19",
		"@types/dotenv": "^6.1.1",
		"@types/express": "^5.0.6",
		"@types/express-rate-limit": "^5.1.3",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/multer": "^2.0.0",
		"@types/node": "^25.2.1",
		"@types/socket.io": "^3.0.1",
		"prisma": "^7.3.0"
	}
}
