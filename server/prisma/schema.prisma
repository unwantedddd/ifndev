generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// model User {
//   id String @id @default(uuid())
//   username String @unique
//   email String @unique
//   password_hash String
// }


model User {
  id            String   @id @default(uuid())
  username      String   @unique
  email         String   @unique
  password_hash String
  
  // Profile fields
  avatar_url    String?
  description   String?
  role          String   @default("USER") // "ADMIN", "USER"
  
  // Relations
  submissions   Submission[]
  posts         Post[]
  comments      Comment[]
  likes         Like[]

  createdAt     DateTime @default(now())
}

// --- CHALLENGE SYSTEM (LeetCode Style) ---

model Problem {
  id            String   @id @default(uuid())
  title         String
  slug          String   @unique // For URL friendly routes e.g. /problems/two-sum
  description   String   // Markdown content
  difficulty    String   // "Easy", "Medium", "Hard"
  
  // Constraints & Testing
  timeLimit     Int      @default(1000) // in milliseconds
  memoryLimit   Int      @default(256)  // in megabytes
  
  // Storing input/output cases as JSON is efficient for SQLite
  // Structure: [{ "input": "...", "output": "..." }, ...]
  testCases     String   // Serialized JSON or use @db.Json if supported by your driver

  // Stats (Denormalized for performance)
  acceptanceRate Float   @default(0)
  
  tags          Tag[]
  submissions   Submission[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Tag {
  id       String    @id @default(uuid())
  name     String    @unique
  problems Problem[]
}

enum SubmissionStatus {
  ACCEPTED
  WRONG_ANSWER
  TIME_LIMIT_EXCEEDED
  COMPILE_ERROR
}

model Submission {
  id        String   @id @default(uuid())
  code      String   // The user's solution code
  language  String   // "python", "javascript", "rust", etc.
 
  // Results
  status    SubmissionStatus   // "ACCEPTED", "WRONG_ANSWER", "TLE", "COMPILE_ERROR"
  runtime   Int?     // Time in ms
  memory    Int?     // Memory in KB
  
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  
  problem   Problem  @relation(fields: [problemId], references: [id])
  problemId String

  createdAt DateTime @default(now())
}

// --- FORUM SYSTEM (StackOverflow/Reddit Style) ---

model Category {
  id    String @id @default(uuid())
  name  String @unique // e.g., "General", "Rust", "React"
  posts Post[]
}

model Post {
  id        String   @id @default(uuid())
  title     String
  content   String   // Markdown
  views     Int      @default(0)
  
  // Optimization: Store counts directly to avoid expensive aggregation queries
  likeCount    Int      @default(0)
  commentCount Int      @default(0)
  
  author    User     @relation(fields: [authorId], references: [id])
  authorId  String
  
  category   Category? @relation(fields: [categoryId], references: [id])
  categoryId String?

  comments  Comment[]
  likes     Like[]    // Relation to track WHO liked what (prevent double voting)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Comment {
  id        String   @id @default(uuid())
  content   String
  likeCount Int      @default(0)

  author    User     @relation(fields: [authorId], references: [id])
  authorId  String
  
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String

  // Optional: Recursive comments (replies)
  parentId  String?
  parent    Comment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies   Comment[] @relation("CommentReplies")

  likes     Like[]

  createdAt DateTime @default(now())
}

// --- VOTING SYSTEM ---

model Like {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String

  // A like can be on a Post OR a Comment
  post      Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String?
  
  comment   Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  commentId String?

  createdAt DateTime @default(now())

  // Constraint: A user can only like a specific post ONCE
  @@unique([userId, postId]) 
  // Constraint: A user can only like a specific comment ONCE
  @@unique([userId, commentId])
}